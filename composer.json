{
    "name": "luany/pt",
    "description": "Luany em Português — a API do framework Luany em português: Modelo, Consulta, Esquema/Tabela, Rota e helpers.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "António Ambrósio Ngola",
            "email": "antoniongola.dev@gmail.com",
            "homepage": "https://github.com/luany-ecosystem",
            "role": "Lead Engineer"
        }
    ],
    "keywords": ["php", "luany", "portugues", "portuguese", "orm", "framework", "pt"],
    "homepage": "https://github.com/luany-ecosystem/luany-pt",
    "require": {
        "php": ">=8.2",
        "luany/core": "^1.4",
        "luany/database": "^1.9",
        "luany/framework": "^1.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Luany\\Pt\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Luany\\Pt\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true
    },
    "minimum-stability": "stable"
}
